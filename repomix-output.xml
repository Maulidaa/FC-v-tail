cr1 |= SPI_CR1_MSTR;      /* mode master */
cr1 |= SPI_CR1_SSM | SPI_CR1_SSI; /* software NSS, internal slave select = 1 (idle) */
cr1 |= br_bits;           /* prescaler baud rate */
