 * bsp_spi.h
 * SPI1 -> IMU MPU6500 (PA4=CS manual, PA5=SCK, PA6=MISO, PA7=MOSI), AF5
 * SPI2 -> Flash W25Q64 blackbox (PB12=CS manual, PB13=SCK, PB14=MISO,
 *         PB15=MOSI), AF5
