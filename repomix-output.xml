⋮----
static void expect_status(uint16_t cmd, uint8_t req, uint8_t status)
⋮----
CHECK(s_tx_cmd == cmd);             /* respons bertipe command test, BUKAN CMD_ERROR */
CHECK(s_tx_req == req);             /* request_id di-echo */
