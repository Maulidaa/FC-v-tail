bool     fix_ok;             /* flag gpsFixOK dari NAV-SOL — WAJIB true
                                  * sebelum posisi dipercaya */
⋮----
uint16_t pdop_x100;          /* pDOP * 100 (skala 0.01 sesuai UBX) */
